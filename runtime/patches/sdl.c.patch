 HL_PRIM void HL_NAME(win_get_size)(SDL_Window *win, int *width, int *height) {
+#ifdef __EMSCRIPTEN__
+	/* SDL_GetWindowSize races with the canvas-resize handler under PROXY_TO_PTHREAD
+	   and can return a zeroed dimension -> 0-size render targets. Read the stable
+	   canvas drawing-buffer size instead, and never report zero. */
+	int cw=0, ch=0; emscripten_get_canvas_element_size("#canvas", &cw, &ch);
+	int sw=0, sh=0; SDL_GetWindowSize(win, &sw, &sh);
+	*width  = cw>0 ? cw : (sw>0 ? sw : 1280);
+	*height = ch>0 ? ch : (sh>0 ? sh : 720);
+#else
 	SDL_GetWindowSize(win, width, height);
+#endif
 }
 
