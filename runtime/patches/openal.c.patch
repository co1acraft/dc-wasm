 HL_PRIM void HL_NAME(al_sourcei)(unsigned source, int param, int value) {
+#ifdef __EMSCRIPTEN__
+	/* AL_DIRECT_FILTER / AL_AUXILIARY_SEND_FILTER are EFX-only params. Emscripten's
+	   OpenAL has no EFX, so passing them raises AL_INVALID_ENUM and wedges the engine's
+	   audio setup at the main menu. EFX is unsupported here, so skip those attaches. */
+	if( param == 0x20005 || param == 0x20006 ) return;
+#endif
 	alSourcei(source, param, value);
 }
 
 HL_PRIM void HL_NAME(al_source3i)(unsigned source, int param, int value1, int value2, int value3) {
+#ifdef __EMSCRIPTEN__
+	if( param == 0x20005 || param == 0x20006 ) return; /* EFX direct/aux-send filter: skip */
+#endif
 	alSource3i(source, param, value1, value2, value3);
 }
 
