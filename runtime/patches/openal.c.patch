 HL_PRIM bool HL_NAME(alc_is_extension_present)(ALCdevice *device, vbyte *extname) {
+#ifdef __EMSCRIPTEN__
+	/* Emscripten's OpenAL has no EFX. Report it absent so the engine (Heaps) skips
+	   the whole effects/filters path -- otherwise it creates filters via stubbed EFX
+	   natives and attaches them with AL_DIRECT_FILTER, which raises AL_INVALID_ENUM
+	   and wedges the audio setup, freezing the game at the main menu. */
+	if( extname && strstr((char*)extname, "EFX") ) return false;
+#endif
 	return alcIsExtensionPresent(device, (char*)extname) == ALC_TRUE;
 }
 
