 HL_PRIM void HL_NAME(gl_bind_frag_data_location)( vdynamic *p, int colNum, vstring *name ) {
+#ifdef __EMSCRIPTEN__
+	/* GLES 3.00 has no glBindFragDataLocation; locations are baked into the shader
+	   via layout(location=) by gl_shader_source. No-op here. */
+	(void)p; (void)colNum; (void)name;
+#else
 	char *cname = hl_to_utf8(name->bytes);
 	glBindFragDataLocation(p->v.i, colNum, cname);
+#endif
 }
 
